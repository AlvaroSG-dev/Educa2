---
// src/components/Footer.astro
import LocationGoogle from "./LocationGoogle.astro";
---

<footer class="bg-gris text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-5" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern
          id="leaf-pattern"
          x="0"
          y="0"
          width="80"
          height="80"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M40 10 C55 18, 62 35, 55 50 C48 64, 28 66, 22 52 C16 38, 22 18, 40 10Z"
            fill="#8fbc4e"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#leaf-pattern)"></rect>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 py-12">
    <div class="flex flex-col md:flex-row md:pl-36 items-center justify-center  gap-8 ">
      <div class="text-center ">
        <div class="inline-flex items-center gap-1 mb-1">
          <img src="/logo.png" alt="educa2" class="h-25 w-auto" />
        </div>
        <p class="text-verde-claro font-semibold text-sm">
          centro psicopedagógico
        </p>
        <p class="text-white/60 text-sm italic mt-0.5">
          "La tranquilidad de saber que nuestro hijo va bien."
        </p>
      </div>
      <LocationGoogle />
    </div>

    <!-- Única sede: Jerez de la Frontera -->

    <nav
      class="flex flex-wrap justify-center gap-4 mb-6 text-sm"
      aria-label="Navegación del pie de página"
    >
      <a href="/" class="text-white/50 hover:text-verde-claro transition-colors"
        >Inicio</a
      >
      <a
        href="/conocenos"
        class="text-white/50 hover:text-verde-claro transition-colors"
        >Conócenos</a
      >
      <a
        href="/psicopedagogia"
        class="text-white/50 hover:text-verde-claro transition-colors"
        >Psicopedagogía</a
      >
      <a
        href="/logopedia"
        class="text-white/50 hover:text-verde-claro transition-colors"
        >Logopedia</a
      >
      <a
        href="/clases-particulares"
        class="text-white/50 hover:text-verde-claro transition-colors"
        >Clases Particulares</a
      >
    </nav>

    <p class="text-center text-white/30 text-xs">
      © {new Date().getFullYear()} educa2 Centro Psicopedagógico · Todos los derechos
      reservados
    </p>
  </div>
</footer>
