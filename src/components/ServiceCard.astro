---
interface Props {
  title: string;
  description?: string;
  icon?: string;
  href?: string;
  accent?: 'verde' | 'morado' | 'burdeos';
}

const {
  title,
  description = '',
  icon = '✦',
  href,
  accent = 'verde',
} = Astro.props;

const accentColors = {
  verde: 'bg-verde/10 text-verde-oscuro border-verde/20 hover:border-verde/50',
  morado: 'bg-morado/10 text-morado border-morado/20 hover:border-morado/40',
  burdeos: 'bg-burdeos/10 text-burdeos border-burdeos/20 hover:border-burdeos/40',
};

const iconColors = {
  verde: 'bg-verde text-white',
  morado: 'bg-morado text-white',
  burdeos: 'bg-burdeos text-white',
};

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class={`service-card group block rounded-2xl p-6 border transition-all duration-300 cursor-default
    opacity-0 translate-y-6
    ${accentColors[accent]}
    ${href ? 'hover:-translate-y-1 hover:shadow-lg cursor-pointer' : ''}
  `}
>
  <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-xl mb-4 ${iconColors[accent]}`}>
    {icon}
  </div>
  <h3 class="font-bold text-gris text-lg mb-2 leading-snug">{title}</h3>
  {description && (
    <p class="text-gris-claro text-sm leading-relaxed">{description}</p>
  )}
  {href && (
    <span class="inline-flex items-center gap-1 mt-3 text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity duration-200" style={`color: var(--tw-${accent})`}>
      Saber más →
    </span>
  )}
</Tag>

<script>
  // IntersectionObserver for fade+slide-up on scroll
  const cards = document.querySelectorAll('.service-card');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = (parseInt(el.dataset.index || '0')) * 100;
          setTimeout(() => {
            el.classList.remove('opacity-0', 'translate-y-6');
            el.classList.add('opacity-100', 'translate-y-0');
          }, delay);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.15 }
  );

  cards.forEach((card, i) => {
    (card as HTMLElement).dataset.index = String(i % 8);
    observer.observe(card);
  });
</script>
