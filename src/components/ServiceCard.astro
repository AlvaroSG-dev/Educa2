---
interface Props {
  title: string;
  description?: string;
  icon?: string;
  href?: string;
  accent?: 'verde' | 'morado' | 'burdeos';
}

const {
  title,
  description = '',
  icon = 'star',
  href,
  accent = 'verde',
} = Astro.props;

const accentColors = {
  verde: 'bg-verde/10 text-verde-oscuro border-verde/20 hover:border-verde/50',
  morado: 'bg-morado/10 text-morado border-morado/20 hover:border-morado/40',
  burdeos: 'bg-burdeos/10 text-burdeos border-burdeos/20 hover:border-burdeos/40',
};

const iconColors = {
  verde: 'bg-verde text-white',
  morado: 'bg-morado text-white',
  burdeos: 'bg-burdeos text-white',
};

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class={`service-card group flex flex-col rounded-2xl p-6 border transition-all duration-300 cursor-default h-full
    ${accentColors[accent]}
    ${href ? 'hover:-translate-y-1 hover:shadow-lg cursor-pointer' : ''}
  `}
>
  <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-4 ${iconColors[accent]}`}>
    <span class="material-symbols-outlined text-2xl">
      {icon}
    </span>
  </div>
  <h3 class="font-bold text-gris text-lg mb-2 leading-snug">{title}</h3>
  {description && (
    <p class="text-gris-claro text-sm leading-relaxed">{description}</p>
  )}
  {href && (
    <span class="inline-flex items-center gap-1 mt-auto pt-3 text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity duration-200" style={`color: var(--tw-${accent})`}>
      Saber más <span class="material-symbols-outlined text-base">arrow_forward</span>
    </span>
  )}
</Tag>

