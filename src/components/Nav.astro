---
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/conocenos', label: 'Conócenos' },
  { href: '/psicopedagogia', label: 'Psicopedagogía' },
  { href: '/logopedia', label: 'Logopedia' },
  { href: '/clases-particulares', label: 'Clases Particulares' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header id="nav-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between" aria-label="Navegación principal">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-1 group" aria-label="educa2 - Inicio">
      <span class="font-display text-2xl font-black" style="color:#b03030;">e</span>
      <span class="font-display text-2xl font-black text-gris">duca</span>
      <span class="font-display text-2xl font-black" style="color:#7b3f9e;">2</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class={`px-3 py-1.5 rounded-full text-sm font-semibold transition-all duration-200
              ${isActive(href)
                ? 'bg-verde text-white shadow-sm'
                : 'text-gris hover:bg-verde-bg hover:text-verde-oscuro'
              }`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <a href="tel:956062004" class="hidden md:inline-flex items-center gap-2 bg-verde text-white text-sm font-bold px-4 py-2 rounded-full hover:bg-verde-oscuro transition-colors duration-200">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
      956 06 2004
    </a>

    <!-- Mobile burger -->
    <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-gris hover:bg-verde-bg" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-verde-bg px-4 pb-4">
    <ul class="flex flex-col gap-1 pt-2" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class={`block px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors
              ${isActive(href)
                ? 'bg-verde text-white'
                : 'text-gris hover:bg-verde-bg'
              }`}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a href="tel:956062004" class="block text-center bg-verde text-white font-bold py-2.5 rounded-xl">
          📞 956 06 2004
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Scroll opacity
  const header = document.getElementById('nav-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('bg-white/95', 'shadow-md', 'backdrop-blur-sm');
      header?.classList.remove('bg-transparent');
    } else {
      header?.classList.remove('bg-white/95', 'shadow-md', 'backdrop-blur-sm');
    }
  }, { passive: true });

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
