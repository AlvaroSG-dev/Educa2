---
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/conocenos", label: "Conócenos" },
  { href: "/psicopedagogia", label: "Psicopedagogía" },
  { href: "/logopedia", label: "Logopedia" },
  { href: "/clases-particulares", label: "Clases Particulares" },
  { href: "/psicologia", label: "Psicología" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header
  id="nav-header"
  class="fixed top-0 backdrop-blur-md border-b border-verde-bg md:border-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav
    class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between"
    aria-label="Navegación principal"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-1 group"
      aria-label="educa2 - Inicio"
    >
      <img src="/logo.png" alt="educa2" class="h-10 w-auto" />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1" role="list">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class={`nav-link px-3 py-1.5 rounded-full text-sm font-semibold transition-all duration-200
              ${
                isActive(href)
                  ? "bg-verde text-white shadow-sm"
                  : "text-white hover:bg-white/20"
              }`}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- CTA -->
    <a
      href="tel:956062004"
      class="hidden md:inline-flex items-center gap-2 bg-white/20 text-white text-sm font-bold px-4 py-2 rounded-full border border-white/30 hover:bg-white hover:text-verde-oscuro transition-all duration-200 nav-cta"
    >
      <span class="material-symbols-outlined text-base" aria-hidden="true"
        >call</span
      >
      956 06 2004
    </a>

    <!-- Mobile burger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 rounded-lg text-gris hover:bg-verde-bg flex items-center justify-center transition-colors"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span
        class="material-symbols-outlined text-3xl font-bold burger-icon text-white"
        aria-hidden="true">menu</span
      >
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white/95 backdrop-blur-md border-t border-verde-bg px-4 pb-4"
  >
    <ul class="flex flex-col gap-1 pt-2" role="list">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class={`block px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors
              ${
                isActive(href)
                  ? "bg-verde text-white"
                  : "text-gris hover:bg-verde-bg"
              }`}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="tel:956062004"
          class="flex items-center justify-center gap-2 bg-verde text-white font-bold py-2.5 rounded-xl"
        >
          <span class="material-symbols-outlined" aria-hidden="true">call</span> 956
          06 2004
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById("nav-header");
  const navLinks = header?.querySelectorAll(".nav-link");
  const navLogoDuca = header?.querySelector(".nav-logo-duca");
  const navCta = header?.querySelector(".nav-cta");
  const burgerIcon = header?.querySelector(".burger-icon");

  function updateNav() {
    // SUBIMOS EL VALOR: 500px suele ser la altura aproximada de esa sección verde inicial.
    // Ajusta este número si quieres que cambie un poco antes o después.
    const scrolled = window.scrollY > 500;

    if (scrolled) {
      // 1. Quitamos el fondo transparente original para que no choque
      header?.classList.remove("bg-transparent");

      // 2. Añadimos el fondo blanco (usamos bg-white seco o bg-white/[0.97] si quieres transparencia exacta)
      // bg-white/50 aplica un 50% de opacidad al fondo. Aumentamos el blur para que lea mejor el texto.
      // Cambiamos 'bg-white' por el degradado de arriba a abajo
      header?.classList.add(
        "bg-gradient-to-b",
        "from-white",
        "to-transparent",
        "backdrop-blur-md",
      );
      navLogoDuca?.classList.replace("text-white", "text-gris");
      // burger icon oscuro
      burgerIcon?.classList.replace("text-white", "text-gris");
      // logo colors oscuros
      header
        ?.querySelector(".nav-logo-e")
        ?.setAttribute("style", "color:#b03030;");
      header
        ?.querySelector(".nav-logo-2")
        ?.setAttribute("style", "color:#7b3f9e;");
      // links
      navLinks?.forEach((l) => {
        if (!l.classList.contains("bg-verde")) {
          l.classList.replace("text-white", "text-gris");
          l.classList.replace("hover:bg-white/20", "hover:bg-verde-bg");
          l.classList.add("hover:text-verde-oscuro");
        }
      });
      // CTA
      navCta?.classList.remove(
        "bg-white/20",
        "text-white",
        "border",
        "border-transparent",
        "hover:border-verde/60",
      );
      navCta?.classList.add("bg-verde", "text-white");
    } else {
      // Al volver arriba, limpiamos el blanco y devolvemos el transparente original
      header?.classList.remove(
        "bg-gradient-to-b",
        "from-white",
        "to-transparent",
        "shadow-md",
        "backdrop-blur-md",
        "backdrop-blur-sm",
        "bg-white",
      );
      header?.classList.add("bg-transparent");

      navLogoDuca?.classList.replace("text-gris", "text-white");
      burgerIcon?.classList.replace("text-gris", "text-white");
      header
        ?.querySelector(".nav-logo-e")
        ?.setAttribute("style", "color:#e87070;");
      header
        ?.querySelector(".nav-logo-2")
        ?.setAttribute("style", "color:#c49ef0;");
      navLinks?.forEach((l) => {
        if (!l.classList.contains("bg-verde")) {
          l.classList.replace("text-gris", "text-white");
          l.classList.replace("hover:bg-verde-bg", "hover:bg-white/20");
          l.classList.remove("hover:text-verde-oscuro");
        }
      });
      navCta?.classList.remove("bg-verde");
      navCta?.classList.add(
        "bg-white/20",
        "text-white",
        "border",
        "border-white/30",
      );
    }
  }

  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();

  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });
</script>
