---
// src/components/FooterLocation.astro
const addressQuery = "Avd.+Reino+Unido,+4,+Jerez+de+la+Frontera";

// Enlace externo para el botón/dirección
const googleMapsExternalUrl = `https://www.google.com/maps/search/?api=1&query=${addressQuery}`;

// URL real y funcional para el iframe de Google Maps
const googleMapsEmbedUrl =
  "https://maps.google.com/maps?q=Avd.%20Reino%20Unido,%204,%20Jerez%20de%20la%20Frontera&t=&z=16&ie=UTF8&iwloc=&output=embed";
---

<div
  class="max-w-md mx-auto  mb-8 bg-white/5 rounded-2xl  text-center hover:bg-white/10 transition-all duration-300"
>
  <div
    class="overflow-hidden rounded-xl border border-white/10 shadow-inner w-full h-48 sm:h-56 relative group/iframe bg-neutral-900"
  >
    <iframe
      src={googleMapsEmbedUrl}
      class="w-full h-full border-0 opacity-85 group-hover/iframe:opacity-100 transition-opacity duration-300"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Mapa interactivo de la ubicación del centro educa2 en Jerez"
    ></iframe>
  </div>
</div>
