---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import HojasSVG from '../components/HojasSVG.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PaintSplash from '../components/PaintSplash.astro';
import FormularioCurriculum from '../components/Formulariocurriculum.astro';

const IMGS = {
  hero: 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?w=1600&q=85&auto=format&fit=crop',
};
---

<Layout
  title="Conócenos"
  description="Conoce educa2, centro psicopedagógico en Jerez de la Frontera y Puerto Real. Más de 15 años acompañando a familias en el desarrollo educativo de sus hijos."
>

  <!-- HERO -->
  <section class="relative min-h-[65vh] flex items-center justify-center overflow-hidden pt-20">
    <div
      id="conocenos-hero-bg"
      class="absolute inset-0 will-change-transform"
      style={`background-image:url('${IMGS.hero}');background-size:cover;background-position:center;filter:blur(3px) brightness(0.3);transform:scale(1.06);`}
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 opacity-60"
      style="background:linear-gradient(135deg,#7b3f9e99 0%,#4a1a7a88 100%);"
      aria-hidden="true"
    />
    <HojasSVG />
    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
      <p class="inline-block bg-white/15 text-white font-bold text-sm px-4 py-1.5 rounded-full mb-5">
        Centro Psicopedagógico · educa2 Jerez
      </p>
      <h1 class="font-display text-6xl md:text-8xl font-black text-white mb-5 leading-tight drop-shadow-xl">
        Quiénes <span style="color:#d4b8ff;">somos</span>
      </h1>
      <p class="text-white/80 text-xl max-w-xl mx-auto leading-relaxed">
        Un equipo de profesionales comprometido con el desarrollo educativo y
        comunicativo de cada niño y joven que pasa por nuestras aulas.
      </p>
    </div>
  </section>

  <PaintSplash color="#ffffff" flip={true} />

  <!-- MISIÓN -->
  <ScrollReveal bgColor="#ffffff" direction="up" className="py-20 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-morado font-bold text-sm tracking-widest uppercase mb-3">Nuestra misión</p>
        <h2 class="font-display text-4xl font-black text-gris mb-5 leading-tight">
          La tranquilidad de saber que tu hijo va bien
        </h2>
        <p class="text-gris-claro leading-relaxed mb-4">
          En educa2 creemos que cada niño tiene un ritmo de aprendizaje propio y que el entorno adecuado marca la diferencia. Trabajamos con familias, colegios y especialistas para ofrecer una respuesta integral.
        </p>
        <p class="text-gris-claro leading-relaxed">
          Llevamos más de 15 años en Jerez de la Frontera y Puerto Real, acompañando a cientos de familias con un equipo cercano, formado y en constante actualización.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <ServiceCard icon="favorite" title="Trato cercano" description="Cada familia recibe atención personalizada desde el primer contacto." accent="morado" />
        <ServiceCard icon="psychology" title="Rigor profesional" description="Métodos avalados por la evidencia científica y actualizados." accent="morado" />
        <ServiceCard icon="handshake" title="Coordinación" description="Trabajamos en red con colegios, familias y otros especialistas." accent="morado" />
        <ServiceCard icon="trending_up" title="Seguimiento real" description="Informamos a las familias del progreso de forma continua." accent="morado" />
      </div>
    </div>
  </ScrollReveal>

  <PaintSplash color="#f3eeff" />

  <!-- VALORES -->
  <ScrollReveal bgColor="#f3eeff" direction="up" className="py-20 px-4">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="font-display text-4xl font-black text-gris mb-12">Nuestros valores</h2>
      <div class="grid md:grid-cols-3 gap-7">
        {[
          { icon: 'potted_plant', title: 'Crecimiento',       desc: 'Cada alumno tiene potencial. Nuestra labor es ayudarle a descubrirlo.' },
          { icon: 'person_search', title: 'Individualización', desc: 'No hay dos casos iguales. Adaptamos cada intervención a la persona.' },
          { icon: 'family_restroom', title: 'Familia',         desc: 'La familia es parte del equipo. La implicamos en todo el proceso.' },
        ].map((v, i) => (
          <div
            class="valores-card bg-white rounded-2xl p-7 text-center border border-morado/20 shadow-sm opacity-0 transition-opacity duration-700"
            style={`transition-delay: ${i * 150}ms`}
          >
            <div class="text-4xl mb-4">
              <span class="material-symbols-outlined text-4xl text-morado" aria-hidden="true">
                {v.icon}
              </span>
            </div>
            <h3 class="font-bold text-gris text-xl mb-2">{v.title}</h3>
            <p class="text-gris-claro text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </ScrollReveal>

  <PaintSplash color="#7b3f9e" />

  <!-- SEDES CTA -->
  <ScrollReveal direction="up" className="py-20 px-4" bgColor="transparent">
    <div class="max-w-2xl mx-auto text-center"
         style="background:linear-gradient(135deg,#7b3f9e 0%,#4a1a7a 100%);
                border-radius:2rem; padding:3rem 2rem;
                box-shadow: 0 20px 60px rgba(123,63,158,0.4);">
      <h2 class="font-display text-4xl font-black text-white mb-4">¿Hablamos?</h2>
      <p class="text-white/90 text-lg mb-8">
        Llámanos o visítanos en nuestra sede de Jerez de la Frontera.
        Estaremos encantados de atenderte.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:956062004"
           class="bg-white text-morado font-bold px-8 py-3 rounded-full
                  hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200">
          Llamar ahora
        </a>
      </div>
    </div>
  </ScrollReveal>

  <!-- FORMULARIO CURRÍCULUM -->
  <FormularioCurriculum />

</Layout>

<script>
  // Parallax hero
  const bg = document.getElementById('conocenos-hero-bg');
  if (bg) {
    window.addEventListener('scroll', () => {
      requestAnimationFrame(() => {
        bg.style.transform = `scale(1.06) translateY(${window.scrollY * 0.25}px)`;
      });
    }, { passive: true });
  }

  // Reveal tarjetas valores
  function initValoresReveal() {
    const cards = document.querySelectorAll<HTMLElement>('.valores-card');
    const obs = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.opacity = '1';
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    cards.forEach(c => obs.observe(c));
  }
  initValoresReveal();
  document.addEventListener('astro:page-load', initValoresReveal);
</script>
