---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ImageCard from '../components/ImageCard.astro';
import PaintSplash from '../components/PaintSplash.astro';
import HojasSVG from '../components/HojasSVG.astro';

const IMGS = {
  hero:    'https://images.unsplash.com/photo-1544027993-37dbfe43562a?w=1600&q=85&auto=format&fit=crop',
  nino1:   'https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=800&q=85&auto=format&fit=crop',
  nino2:   'https://images.unsplash.com/photo-1571260898995-4ae0a0d5bd79?w=1600&q=85&auto=format&fit=crop',
  nino3:   'https://images.unsplash.com/photo-1577896851231-70ef18881754?w=800&q=85&auto=format&fit=crop',
};

const servicios = [
  { icon: 'record_voice_over', title: 'Trastornos del Habla', description: 'Intervención en dislalia, disfemia (tartamudez), disartria y otros trastornos que afectan a la articulación y fluidez del habla.' },
  { icon: 'hearing', title: 'Trastornos de la Audición', description: 'Rehabilitación auditiva y trabajo con implantes cocleares, hipoacusia y otras alteraciones de la percepción auditiva.' },
  { icon: 'settings_voice', title: 'Perturbaciones de la Voz', description: 'Tratamiento de disfonías, nódulos vocales, voz nasal y otros problemas que afectan a la calidad y resistencia de la voz.' },
  { icon: 'description', title: 'Alteraciones del Lenguaje', description: 'Intervención en retrasos del lenguaje, trastornos específicos, dislexia, disgrafía y dificultades de comprensión y expresión.' },
];
---

<Layout
  title="Logopedia"
  description="Logopedia en educa2 Jerez — Trastornos del habla, audición, voz y lenguaje. Tratamiento personalizado para niños y adultos."
>

  <!-- HERO con imagen difuminada + parallax -->
  <section class="relative min-h-[65vh] flex items-center justify-center overflow-hidden pt-20">
    <div id="logo-hero-bg" class="absolute inset-0 will-change-transform"
      style={`background-image:url('${IMGS.hero}');background-size:cover;background-position:center;filter:blur(3px) brightness(0.3);transform:scale(1.06);`}
      aria-hidden="true"
    />
    <div class="absolute inset-0 opacity-60"
      style="background:linear-gradient(135deg,#7b3f9e99 0%,#4a1a7a88 100%);"
      aria-hidden="true"
    />
    <HojasSVG />
    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
      <p class="inline-block bg-white/15 text-white font-bold text-sm px-4 py-1.5 rounded-full mb-5">
        Área de Logopedia · educa2 Jerez
      </p>
      <h1 class="font-display text-6xl md:text-8xl font-black text-white mb-5 leading-tight drop-shadow-xl">
        Cada voz <span style="color:#d4b8ff;">importa</span>
      </h1>
      <p class="text-white/80 text-xl max-w-xl mx-auto leading-relaxed">
        Ayudamos a niños y adultos a superar las dificultades en el habla,
        la comunicación y el lenguaje con un tratamiento personalizado y cercano.
      </p>
    </div>
  </section>

  <PaintSplash color="#ffffff" flip={true} />

  <!-- ÁREAS DE INTERVENCIÓN -->
  <ScrollReveal bgColor="#ffffff" direction="up" className="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-morado font-bold text-sm tracking-widest uppercase mb-2">Intervención especializada</p>
        <h2 class="font-display text-4xl font-black text-gris mb-4">Áreas de trabajo</h2>
        <p class="text-gris-claro max-w-xl mx-auto">Cuatro grandes áreas, siempre con una valoración inicial individualizada para diseñar el plan más adecuado.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {servicios.map(s => (
          <ServiceCard title={s.title} description={s.description} icon={s.icon} accent="morado" />
        ))}
      </div>
    </div>
  </ScrollReveal>

  <PaintSplash color="#f3eeff" />

  <!-- METODOLOGÍA con imagen difuminada de fondo -->
  <ScrollReveal bgImage={IMGS.nino2} direction="left" className="py-24 px-4" minHeight="480px">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display text-4xl font-black text-white mb-4 drop-shadow-lg">Nuestra metodología</h2>
        <p class="text-white/70 max-w-xl mx-auto">Un proceso estructurado centrado en el bienestar de cada paciente.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { num: '01', icon: 'manage_search', title: 'Evaluación inicial', desc: 'Valoración completa para diseñar un plan de intervención personalizado.' },
          { num: '02', icon: 'bolt', title: 'Intervención activa', desc: 'Sesiones dinámicas y motivadoras con técnicas actualizadas y adaptadas.' },
          { num: '03', icon: 'handshake', title: 'Seguimiento familiar', desc: 'Orientamos a la familia para que el trabajo continúe en casa de forma natural.' },
        ].map((step, i) => (
          <div class="metodo-card text-center bg-white/20 backdrop-blur-sm rounded-2xl p-7
                      border border-white/30 opacity-0 transition-opacity duration-700"
               style={`transition-delay: ${i * 150}ms`}>
            <div class="font-display text-5xl font-black mb-2 text-white/30">{step.num}</div>
            <div class="text-3xl mb-3">
              <span class="material-symbols-outlined text-4xl text-white" aria-hidden="true">
                {step.icon}
              </span>
            </div>
            <h3 class="font-bold text-white text-xl mb-2">{step.title}</h3>
            <p class="text-white/85 text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </ScrollReveal>

  <PaintSplash color="#ffffff" flip={true} />

  <!-- GALERÍA -->
  <ScrollReveal bgColor="#f8fdf2" direction="up" className="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display text-4xl font-black text-gris mb-3">Nuestros pacientes, nuestra motivación</h2>
        <p class="text-gris-claro max-w-xl mx-auto">Cada progreso, por pequeño que sea, es un gran logro para toda la familia.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        <ImageCard image={IMGS.nino1} alt="Niño aprendiendo" title="Primeros avances" description="Cada sesión cuenta para construir confianza." href="/conocenos" accent="#7b3f9e"/>
        <ImageCard image={IMGS.hero} alt="Niño leyendo" title="Leer con confianza" description="Superando las barreras del lenguaje escrito." href="/conocenos" accent="#7b3f9e"/>
        <ImageCard image={IMGS.nino3} alt="Niños felices" title="Resultados reales" description="Familias satisfechas con el progreso obtenido." href="/conocenos" accent="#7b3f9e"/>
      </div>
    </div>
  </ScrollReveal>

  <PaintSplash color="#7b3f9e" />

  <!-- CTA -->
  <ScrollReveal direction="up" bgColor="#f3eeff" className="py-16 px-4">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="font-display text-3xl font-black text-gris mb-4">¿Tiene tu hijo dificultades al hablar?</h2>
      <p class="text-gris-claro mb-8">Una evaluación temprana marca la diferencia. Contáctanos hoy sin compromiso.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="tel:956062004" class="bg-morado text-white font-bold px-8 py-3 rounded-full hover:bg-morado/80 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">Llamar ahora</a>
        <a href="/conocenos" class="border-2 border-morado text-morado font-bold px-8 py-3 rounded-full hover:bg-morado hover:text-white transition-all duration-200">Conócenos</a>
      </div>
    </div>
  </ScrollReveal>

</Layout>

<script>
  // Parallax hero
  const bg = document.getElementById('logo-hero-bg');
  if (bg) {
    window.addEventListener('scroll', () => {
      requestAnimationFrame(() => {
        bg.style.transform = `scale(1.06) translateY(${window.scrollY * 0.25}px)`;
      });
    }, { passive: true });
  }

  // Reveal tarjetas metodología
  function initMetodoReveal() {
    const cards = document.querySelectorAll<HTMLElement>('.metodo-card');
    const obs = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.opacity = '1';
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    cards.forEach(c => obs.observe(c));
  }
  initMetodoReveal();
  document.addEventListener('astro:page-load', initMetodoReveal);
</script>
