---
import Layout from "../layouts/Layout.astro";
import HojasSVG from "../components/HojasSVG.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PaintSplash from "../components/PaintSplash.astro";

const IMGS = {
  hero: 'https://images.unsplash.com/photo-1604881991720-f91add269bed?w=1600&q=85&auto=format&fit=crop',
  neuro: 'https://images.unsplash.com/photo-1758273241078-8eec353836be?w=1600&q=85&auto=format&fit=crop',
};
---

<Layout
  title="Psicología"
  description="Servicio de psicología en educa2 — Ansiedad, conducta, neuropsicología y bienestar emocional para niños, adolescentes y adultos en Jerez de la Frontera y Puerto Real."
>
  <!-- HERO con imagen difuminada + parallax -->
  <section class="relative min-h-[65vh] flex items-center justify-center overflow-hidden pt-20">
    <div id="psicologia-hero-bg" class="absolute inset-0 will-change-transform"
      style={`background-image:url('${IMGS.hero}');background-size:cover;background-position:center;filter:blur(3px) brightness(0.3);transform:scale(1.06);`}
      aria-hidden="true"
    />
    <div class="absolute inset-0 opacity-60"
      style="background:linear-gradient(135deg,#16290c99 0%,#0e1f0a88 100%);"
      aria-hidden="true"
    />
    <HojasSVG />
    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
      <p class="inline-block bg-white/15 text-white font-bold text-sm px-4 py-1.5 rounded-full mb-5">
        Salud mental para todos
      </p>
      <h1 class="font-display text-6xl md:text-8xl font-black text-white mb-5 leading-tight drop-shadow-xl">
        Psicología <span style="color:#c5e1a5;">para todos</span>
      </h1>
      <p class="text-white/80 text-xl max-w-xl mx-auto leading-relaxed">
        Acompañamos a niños, adolescentes y adultos en su bienestar emocional,
        ayudándoles a superar dificultades con un enfoque cercano, profesional y
        adaptado a cada etapa vital.
      </p>
    </div>
  </section>

  <PaintSplash color="#ffffff" flip={true} />

  <!-- ESPECIALIDADES -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-verde font-bold text-sm tracking-widest uppercase mb-2">
          Especialidades
        </p>
        <h2 class="font-display text-4xl font-black text-gris mb-4">
          ¿En qué podemos ayudar?
        </h2>
        <p class="text-gris-claro max-w-xl mx-auto">
          Trabajamos con personas de todas las edades y sus familias en una amplia
          variedad de áreas de la salud mental.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <ServiceCard
          icon="psychology"
          title="Neuropsicología"
          description="Evaluación e intervención en el funcionamiento cerebral: memoria, atención, funciones ejecutivas y desarrollo cognitivo en cualquier etapa de la vida."
          accent="verde"
        />
        <ServiceCard
          icon="sentiment_dissatisfied"
          title="Ansiedad y miedos"
          description="Tratamiento de fobias, ansiedad generalizada, ansiedad social y ataques de pánico en niños, adolescentes y adultos."
          accent="verde"
        />
        <ServiceCard
          icon="mood_bad"
          title="Estado de ánimo"
          description="Intervención en tristeza persistente, baja autoestima, apatía y estados depresivos, adaptada a cada persona y momento vital."
          accent="verde"
        />
        <ServiceCard
          icon="warning"
          title="Problemas de conducta"
          description="Orientación y tratamiento ante dificultades de regulación emocional, impulsividad y gestión del comportamiento en todas las edades."
          accent="verde"
        />
        <ServiceCard
          icon="domain"
          title="Adaptación y cambios vitales"
          description="Apoyo psicológico ante situaciones de cambio, estrés laboral, duelo, rupturas o cualquier transición que genere malestar emocional."
          accent="verde"
        />
        <ServiceCard
          icon="family_restroom"
          title="Orientación familiar"
          description="Pautas y estrategias para que las familias acompañen el desarrollo emocional de sus hijos y gestionen la convivencia de forma saludable."
          accent="verde"
        />
        <ServiceCard
          icon="diversity_3"
          title="Habilidades sociales"
          description="Entrenamiento en comunicación, resolución de conflictos y relaciones interpersonales para niños, jóvenes y adultos."
          accent="verde"
        />
        <ServiceCard
          icon="restaurant"
          title="Conducta alimentaria"
          description="Detección e intervención en dificultades relacionadas con la alimentación y la imagen corporal en cualquier etapa de la vida."
          accent="verde"
        />
        <ServiceCard
          icon="bedtime"
          title="Problemas de sueño"
          description="Evaluación y tratamiento de insomnio, pesadillas y otros trastornos del sueño tanto en infancia como en la edad adulta."
          accent="verde"
        />
      </div>
    </div>
  </section>

  <!-- NEUROPSICOLOGÍA — imagen + verde oscuro -->
  <section class="relative overflow-hidden py-20 px-4" style="background-color:#0a1a05;">
    <div id="neuro-bg" class="absolute inset-0 will-change-transform"
      style={`background-image:url('${IMGS.neuro}');background-size:cover;background-position:center;filter:blur(2px) brightness(0.55);transform:scale(1.15);`}
      aria-hidden="true"
    />
    <div class="absolute inset-0 opacity-70"
      style="background:linear-gradient(135deg,#122408 0%,#0a1a05 100%);"
      aria-hidden="true"
    />
    <div class="max-w-5xl mx-auto relative z-10">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p
            class="text-verde-claro font-bold text-sm tracking-widest uppercase mb-3"
          >
            Área destacada
          </p>
          <h2
            class="font-display text-4xl font-black text-white mb-5 leading-tight"
          >
            Neuropsicología <span style="color:#c5e1a5;">clínica</span>
          </h2>
          <p class="text-white/80 leading-relaxed mb-4">
            La neuropsicología estudia la relación entre el cerebro y la
            conducta. En educa2 realizamos evaluaciones neuropsicológicas
            completas para entender cómo funciona la mente de cada persona: su
            memoria, atención, lenguaje, funciones ejecutivas y capacidad de
            aprendizaje, tanto en la infancia como en la etapa adulta.
          </p>
          <p class="text-white/80 leading-relaxed">
            A partir de los resultados diseñamos un plan de intervención
            personalizado y coordinamos con el entorno familiar, escolar o
            laboral para garantizar el mejor acompañamiento posible.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          {
            [
              { icon: "ads_click", label: "Evaluación de atención" },
              { icon: "memory", label: "Memoria y aprendizaje" },
              { icon: "settings", label: "Funciones ejecutivas" },
              { icon: "assessment", label: "Informe neuropsicológico" },
            ].map((item) => (
              <div
                class="neuro-card bg-white rounded-2xl p-5 border border-verde/20 text-center shadow-sm
                        opacity-0 transition-all duration-700 hover:-translate-y-1 hover:shadow-md"
              >
                <div class="text-3xl mb-2">
                  <span class="material-symbols-outlined text-4xl text-verde" aria-hidden="true">
                    {item.icon}
                  </span>
                </div>
                <p class="font-semibold text-gris text-sm">{item.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display text-4xl font-black text-gris mb-4">
          Cómo trabajamos
        </h2>
        <p class="text-gris-claro max-w-xl mx-auto">
          Un proceso claro, humano y centrado en el bienestar de la persona y su
          entorno.
        </p>
      </div>
      <div class="grid md:grid-cols-4 gap-6">
        {
          [
            {
              num: "01",
              icon: "forum",
              title: "Primera consulta",
              desc: "Escuchamos a la persona y, cuando es el caso, también a su familia, para recoger toda la información relevante sobre la situación.",
            },
            {
              num: "02",
              icon: "manage_search",
              title: "Evaluación",
              desc: "Aplicamos pruebas adaptadas a cada edad y perfil para obtener una visión completa del estado emocional y cognitivo.",
            },
            {
              num: "03",
              icon: "assignment",
              title: "Plan terapéutico",
              desc: "Diseñamos un plan personalizado con objetivos concretos y técnicas basadas en la evidencia.",
            },
            {
              num: "04",
              icon: "trending_up",
              title: "Seguimiento",
              desc: "Revisamos el progreso periódicamente e informamos con total transparencia a la persona y, si procede, a su familia.",
            },
          ].map((step) => (
            <div class="service-card text-center bg-[#f8fdf2] rounded-2xl p-5 border border-verde/20 opacity-0 translate-y-6">
              <div class="font-display text-4xl font-black mb-1 text-verde opacity-30">
                {step.num}
              </div>
              <div class="text-3xl mb-3">
                <span class="material-symbols-outlined text-4xl text-verde" aria-hidden="true">
                  {step.icon}
                </span>
              </div>
              <h3 class="font-bold text-gris mb-2">{step.title}</h3>
              <p class="text-gris-claro text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

<!-- CTA -->
  <section class="py-16 px-4 bg-white text-center">
    <div class="max-w-xl mx-auto">
      <h2 class="font-display text-3xl font-black text-gris mb-4">
        ¿Crees que necesitas apoyo psicológico?
      </h2>
      <p class="text-gris-claro mb-8">
        Una primera consulta no compromete a nada y puede marcar el inicio de un
        gran cambio. Estamos aquí para acompañarte.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="tel:956062004" class="bg-verde text-white font-bold px-8 py-3 rounded-full hover:bg-verde-oscuro transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg inline-flex items-center gap-2">
          <span class="material-symbols-outlined text-base" aria-hidden="true">call</span>
          Pedir cita
        </a>
        <a href="/psicopedagogia" class="border-2 border-verde text-verde font-bold px-8 py-3 rounded-full hover:bg-verde hover:text-white transition-all duration-200 inline-flex items-center gap-2">
          Ver Psicopedagogía
          <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

<script>
  // Parallax hero
  const bg = document.getElementById('psicologia-hero-bg');
  if (bg) {
    window.addEventListener('scroll', () => {
      requestAnimationFrame(() => {
        bg.style.transform = `scale(1.06) translateY(${window.scrollY * 0.25}px)`;
      });
    }, { passive: true });
  }

  // Parallax neuropsicología
  const neuroBg = document.getElementById('neuro-bg');
  if (neuroBg) {
    const maxOffset = 40; // px — debe quedarse dentro del margen que da scale(1.15)
    window.addEventListener('scroll', () => {
      requestAnimationFrame(() => {
        const rect = neuroBg.parentElement!.getBoundingClientRect();
        const raw = rect.top * 0.1;
        const offset = Math.max(-maxOffset, Math.min(maxOffset, raw));
        neuroBg.style.transform = `scale(1.15) translateY(${offset}px)`;
      });
    }, { passive: true });
  }

  function initReveal() {
    const stepCards = document.querySelectorAll<HTMLElement>(".service-card");
    const stepObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            setTimeout(() => {
              el.style.opacity = "1";
              el.style.transform = "translateY(0)";
            }, i * 120);
            stepObs.unobserve(el);
          }
        });
      },
      { threshold: 0.1 },
    );
    stepCards.forEach((c) => {
      c.style.transition = "opacity 0.6s ease, transform 0.6s ease";
      stepObs.observe(c);
    });

    const neuroCards = document.querySelectorAll<HTMLElement>(".neuro-card");
    const neuroObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            setTimeout(() => {
              el.style.opacity = "1";
            }, i * 120);
            neuroObs.unobserve(el);
          }
        });
      },
      { threshold: 0.15 },
    );
    neuroCards.forEach((c) => neuroObs.observe(c));
  }

  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>