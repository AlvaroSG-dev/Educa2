---
import Layout from '../layouts/Layout.astro';
import HojasSVG from '../components/HojasSVG.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ImageCard from '../components/ImageCard.astro';
import CentralImage from '../components/CentralImage.astro';
import { IMAGES_CATALOG } from '../data/images';
---

<Layout
  title="Inicio"
  description="educa2, centro psicopedagógico en Jerez de la Frontera. Logopedia, clases particulares y atención psicopedagógica para niños y jóvenes."
>

  <!-- ══════════════════════════════════════════
       HERO — imagen de fondo + hojas parallax
  ══════════════════════════════════════════ -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background: linear-gradient(160deg,#0e1f0a 0%,#162a0c 100%);"
  >
    <!-- Imagen de fondo con parallax -->
    <CentralImage 
      id="home_hero"
      containerId="hero-bg"
      isBackground={true}
      className="will-change-transform"
      backgroundPosition="center 30%"
      brightness={0.38}
      scale={1.06}
      style="filter: brightness(0.38) saturate(0.8);"
      fetchpriority="high"
      loading="eager"
    />
    <!-- Overlay gradiente verde oscuro —> verde medio para legibilidad -->
    <div class="absolute inset-0"
      style="background: linear-gradient(170deg, rgba(10,30,5,0.72) 0%, rgba(90,138,31,0.45) 60%, rgba(143,188,78,0.25) 100%);"
      aria-hidden="true"
    />

    <HojasSVG />

    <!-- Contenido -->
    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto pt-24 pb-16">
      <p class="hero-anim inline-block bg-white/15 text-white font-bold text-sm
                px-4 py-1.5 rounded-full mb-6 backdrop-blur-sm border border-white/20"
         style="animation-delay:0.05s">
        Centro Psicopedagógico · Jerez de la Frontera
      </p>

      <div class="hero-anim flex items-baseline justify-center gap-1 mb-3"
           style="animation-delay:0.15s">
        <span class="font-display text-8xl md:text-[9rem] font-black leading-none drop-shadow-lg"
              style="color:#e87070;">e</span>
        <span class="font-display text-7xl md:text-8xl font-black text-white leading-none drop-shadow-sm">duca</span>
        <span class="font-display text-8xl md:text-[9rem] font-black leading-none drop-shadow-lg"
              style="color:#c49ef0;">2</span>
      </div>

      <p class="hero-anim text-white/80 text-lg font-semibold mb-2"
         style="animation-delay:0.3s">
        centro psicopedagógico
      </p>
      <p class="hero-anim text-white/90 text-xl md:text-2xl italic font-light mb-10"
         style="animation-delay:0.45s">
        "La tranquilidad de saber que nuestro hijo va bien."
      </p>

      <div class="hero-anim flex flex-wrap justify-center gap-3"
           style="animation-delay:0.6s">
        <a href="/clases-particulares"
           class="bg-burdeos text-white font-bold px-7 py-3 rounded-full shadow-lg
                  hover:bg-burdeos/80 hover:-translate-y-0.5 transition-all duration-200">
          Clases Particulares
        </a>
        <a href="/logopedia"
           class="bg-morado text-white font-bold px-7 py-3 rounded-full shadow-lg
                  hover:bg-morado/80 hover:-translate-y-0.5 transition-all duration-200">
          Logopedia
        </a>
        <a href="/conocenos"
           class="bg-white/80 text-gris font-semibold px-5 py-3 rounded-full
                  hover:bg-white transition-all duration-200">
          Conócenos 
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1
                text-white/60 animate-bounce">
      <span class="text-xs font-semibold tracking-widest uppercase">Descubre</span>
      <span class="material-symbols-outlined text-xl" aria-hidden="true">expand_more</span>
    </div>
  </section>



  <!-- ══════════════════════════════════════════
       SECCIÓN 1 — ¿QUÉ HACEMOS? (scroll reveal)
  ══════════════════════════════════════════ -->
  <ScrollReveal bgColor="#ffffff" direction="up" className="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14 reveal-child" data-reveal-delay="0">
        <p class="text-verde-oscuro font-bold text-sm tracking-widest uppercase mb-2">Nuestros servicios</p>
        <h2 class="font-display text-4xl md:text-5xl font-black text-gris mb-4">
          ¿En qué podemos ayudarte?
        </h2>
        <p class="text-gris-claro max-w-xl mx-auto">
          Acompañamos a niños y jóvenes en su desarrollo educativo y comunicativo
          desde un enfoque integral y personalizado.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 items-stretch">
        <div class="reveal-child h-full" data-reveal-delay="100"><ServiceCard title="Conócenos" description="Quiénes somos y cómo trabajamos cada día." icon="potted_plant" href="/conocenos" accent="verde"/></div>
        <div class="reveal-child h-full" data-reveal-delay="200"><ServiceCard title="Psicopedagogía" description="Evaluación, diagnóstico e intervención en dificultades del aprendizaje." icon="psychology" href="/psicopedagogia" accent="verde"/></div>
        <div class="reveal-child h-full" data-reveal-delay="300"><ServiceCard title="Logopedia" description="Prevención y tratamiento de trastornos del habla, la voz y el lenguaje." icon="forum" href="/logopedia" accent="morado"/></div>
        <div class="reveal-child h-full" data-reveal-delay="400"><ServiceCard title="Clases Particulares" description="Refuerzo personalizado con profesores especializados para todos los niveles." icon="school" href="/clases-particulares" accent="burdeos"/></div>
      </div>
    </div>
  </ScrollReveal>



  <!-- ══════════════════════════════════════════
       SECCIÓN 2 — LOGOPEDIA (imagen difuminada + scroll reveal)
  ══════════════════════════════════════════ -->
  <ScrollReveal
    bgImage={IMAGES_CATALOG.home_ninos_talking.src}
    bgOverlay="linear-gradient(135deg, rgba(60,20,90,0.72) 0%, rgba(123,63,158,0.5) 50%, rgba(30,10,50,0.6) 100%)"
    direction="left"
    className="py-24 px-4"
    minHeight="520px"
  >
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="reveal-child" data-reveal-delay="0">
          <p class="text-white font-bold text-sm tracking-widest uppercase mb-3
                    bg-white/20 inline-block px-3 py-1 rounded-full backdrop-blur-sm">Logopedia</p>
          <h2 class="font-display text-4xl md:text-5xl font-black text-white mb-5 leading-tight drop-shadow-lg">
            Cada voz <span style="color:#e4d0ff;">merece ser<br/>escuchada</span>
          </h2>
          <p class="text-white/90 leading-relaxed mb-8 text-lg drop-shadow">
            Nuestro equipo de logopedas trabaja con niños y adultos para superar
            dificultades del habla, la comunicación y el lenguaje con un tratamiento
            personalizado y cercano.
          </p>
          <a href="/logopedia"
             class="inline-flex items-center gap-2 bg-white text-morado font-bold
                    px-7 py-3 rounded-full shadow-lg
                    hover:bg-morado hover:text-white hover:-translate-y-0.5
                    transition-all duration-200">
            Ver servicios de Logopedia <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
          </a>
        </div>

        <!-- Grid de 4 áreas -->
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: 'record_voice_over', label: 'Trastornos del habla' },
            { icon: 'hearing', label: 'Trastornos de la audición' },
            { icon: 'settings_voice', label: 'Perturbaciones de la voz' },
            { icon: 'description', label: 'Alteraciones del lenguaje' },
          ].map((item, i) => (
            <div class="reveal-child bg-white/20 backdrop-blur-sm rounded-2xl p-5
                        border border-white/30 text-center
                        hover:bg-white/30 transition-all duration-300
                        hover:-translate-y-1 hover:shadow-lg"
                 data-reveal-delay={String(i * 120)}>
              <div class="text-3xl mb-2">
                <span class="material-symbols-outlined text-4xl text-white" aria-hidden="true">
                  {item.icon}
                </span>
              </div>
              <p class="font-semibold text-white text-sm drop-shadow">{item.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </ScrollReveal>



  <!-- ══════════════════════════════════════════
       SECCIÓN 3 — GALERÍA DE IMÁGENES (scroll reveal)
  ══════════════════════════════════════════ -->
  <ScrollReveal bgColor="#f8fdf2" direction="up" className="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 reveal-child" data-reveal-delay="0">
        <p class="text-verde-oscuro font-bold text-sm tracking-widest uppercase mb-2">Nuestro entorno</p>
        <h2 class="font-display text-4xl font-black text-gris">
          Un espacio pensado para aprender
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <div class="reveal-child" data-reveal-delay="100">
          <ImageCard
            image={IMAGES_CATALOG.home_reading_warm.src}
            alt={IMAGES_CATALOG.home_reading_warm.alt}
            title="Lectura y comprensión"
            description="Fomentamos el amor por la lectura desde pequeños."
            href="/clases-particulares"
            accent="#b03030"
          />
        </div>
        <div class="reveal-child" data-reveal-delay="250">
          <ImageCard
            image={IMAGES_CATALOG.home_studying.src}
            alt={IMAGES_CATALOG.home_studying.alt}
            title="Concentración y esfuerzo"
            description="Técnicas de estudio adaptadas a cada alumno."
            href="/psicopedagogia"
            accent="#8fbc4e"
          />
        </div>
        <div class="reveal-child" data-reveal-delay="400">
          <ImageCard
            image={IMAGES_CATALOG.home_happy_kids.src}
            alt={IMAGES_CATALOG.home_happy_kids.alt}
            title="Aprender con alegría"
            description="El aprendizaje es más efectivo cuando es disfrutable."
            href="/conocenos"
            accent="#7b3f9e"
          />
        </div>
      </div>
    </div>
  </ScrollReveal>



  <!-- ══════════════════════════════════════════
       SECCIÓN 4 — CLASES PARTICULARES (imagen difuminada + scroll reveal)
  ══════════════════════════════════════════ -->
  <ScrollReveal
    bgImage={IMAGES_CATALOG.home_classes.src}
    bgOverlay="linear-gradient(135deg, rgba(100,20,20,0.72) 0%, rgba(176,48,48,0.5) 50%, rgba(50,10,10,0.65) 100%)"
    direction="right"
    className="py-24 px-4"
    minHeight="480px"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 reveal-child" data-reveal-delay="0">
        <p class="text-white font-bold text-sm tracking-widest uppercase mb-3
                  bg-white/20 inline-block px-3 py-1 rounded-full backdrop-blur-sm">
          Clases Particulares
        </p>
        <h2 class="font-display text-4xl md:text-5xl font-black text-white mb-4 drop-shadow-lg">
          Aprendizaje <span style="color:#ffcece;">a tu medida</span>
        </h2>
        <p class="text-white/90 max-w-xl mx-auto text-lg drop-shadow">
          Grupos reducidos, profesores especializados y seguimiento psicopedagógico
          para garantizar el progreso de cada alumno.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        {[
          { icon: 'groups', label: 'Grupos reducidos' },
          { icon: 'school', label: 'Profesores especializados' },
          { icon: 'language', label: 'Clases de idiomas' },
          { icon: 'square_foot', label: 'Todas las materias' },
          { icon: 'psychology', label: 'Seg. psicopedagógico' },
          { icon: 'assignment', label: 'Prep. de pruebas' },
          { icon: 'home', label: 'Clases a domicilio' },
          { icon: 'backpack', label: 'Todos los niveles' },
        ].map((item, i) => (
          <div class="reveal-child bg-white/20 backdrop-blur-sm rounded-2xl p-4
                      border border-white/30 text-center
                      hover:bg-white/30 hover:-translate-y-1 hover:shadow-lg
                      transition-all duration-300"
               data-reveal-delay={String(50 + i * 80)}>
            <div class="text-2xl mb-1.5 line-height-0">
              <span class="material-symbols-outlined text-3xl text-white" aria-hidden="true">
                {item.icon}
              </span>
            </div>
            <p class="font-semibold text-white text-xs drop-shadow">{item.label}</p>
          </div>
        ))}
      </div>

      <div class="text-center reveal-child" data-reveal-delay="750">
        <a href="/clases-particulares"
           class="inline-flex items-center gap-2 bg-white text-burdeos font-bold
                  px-8 py-3 rounded-full shadow-lg
                  hover:bg-burdeos hover:text-white hover:-translate-y-0.5
                  transition-all duration-200">
          Ver todos los servicios <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </div>
  </ScrollReveal>



  <!-- ══════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════ -->
  <ScrollReveal direction="up" className="py-20 px-4"
    bgColor="transparent">
    <div class="max-w-2xl mx-auto text-center"
         style="background:linear-gradient(135deg,#6fa832 0%,#4a7a12 100%);
                border-radius:2rem; padding:3rem 2rem;
                box-shadow: 0 20px 60px rgba(90,138,31,0.4);">
      <div class="reveal-child" data-reveal-delay="0">
        <h2 class="font-display text-4xl font-black text-white mb-4">¿Hablamos?</h2>
        <p class="text-white/90 text-lg mb-8">
          Llámanos o visítanos en nuestra sede de Jerez de la Frontera.
          Estaremos encantados de atenderte.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-4 reveal-child" data-reveal-delay="200">
        <a href="tel:956062004"
           class="bg-white text-verde-oscuro font-bold px-8 py-3 rounded-full
                  hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200">
          Llamar ahora
        </a>
        <a href="/conocenos"
           class="border-2 border-white text-white font-bold px-8 py-3 rounded-full
                  hover:bg-white/20 transition-colors duration-200">
          Conócenos
        </a>
      </div>
    </div>
  </ScrollReveal>

</Layout>

<style>
  /* Hero animations */
  .hero-anim {
    opacity: 0;
    transform: translateY(28px);
    animation: heroFadeUp 0.7s cubic-bezier(0.22,1,0.36,1) forwards;
  }
  @keyframes heroFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Reveal children — solo opacidad, sin translateY para evitar gaps de layout */
  .reveal-child {
    opacity: 0;
    transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1);
  }
  .reveal-child.revealed {
    opacity: 1;
  }
</style>

<script>
  // Hero background parallax
  const heroBg = document.getElementById('hero-bg');
  if (heroBg) {
    window.addEventListener('scroll', () => {
      requestAnimationFrame(() => {
        const y = window.scrollY;
        heroBg.style.transform = `scale(1.06) translateY(${y * 0.3}px)`;
      });
    }, { passive: true });
  }

  // Stagger reveal for children inside .scroll-reveal-section
  function initChildReveal() {
    const children = document.querySelectorAll<HTMLElement>('.reveal-child');
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = parseInt(el.dataset.revealDelay || '0');
            setTimeout(() => el.classList.add('revealed'), delay);
            obs.unobserve(el);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    children.forEach(c => obs.observe(c));
  }

  initChildReveal();
  document.addEventListener('astro:page-load', initChildReveal);
</script>
